{
  "manifest_version": 3,
  "name": "Cheapr: Price History, Coupons & Spend Lens",
  "short_name": "Cheapr",
  "version": "0.1.0",
  "description": "Price history and drop alerts for Amazon, Flipkart, Myntra and Ajio, automatic coupons at checkout, and a private spending tracker.",
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "background": {"service_worker": "background.js"},
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": [
    "http://localhost/*", "http://127.0.0.1/*",
    "https://www.amazon.in/*", "https://www.flipkart.com/*", "https://www.myntra.com/*", "https://www.ajio.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*", "https://www.flipkart.com/*", "https://www.myntra.com/*", "https://www.ajio.com/*"],
      "js": ["lib/extract.js", "content/product.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*/*"],
      "exclude_matches": ["*://*.gov.in/*", "*://*.nic.in/*", "*://*.bank.in/*", "*://*.edu/*", "*://*.ac.in/*"],
      "js": ["content/coupons.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.amazon.in/*", "https://www.flipkart.com/*", "https://www.swiggy.com/*", "https://www.zomato.com/*"],
      "js": ["content/spend.js"],
      "run_at": "document_idle"
    }
  ]
}
