# Copy to .env. All optional.
POSTGRES_PASSWORD=change-me
ADMIN_TOKEN=          # enables POST /api/v1/coupons
SMTP_HOST=            # enables price-drop emails
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@yourdomain
TELEGRAM_BOT_TOKEN=    # from @BotFather; enables Telegram alerts (worker links chats)
TELEGRAM_BOT_USERNAME= # bot username without @, e.g. CheaprAlertsBot
REFRESH_HOURS=6        # worker re-checks watched products not seen for this long
TRUST_PROXY=           # set to 1 behind a reverse proxy so rate limits use the client IP
